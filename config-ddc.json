{
  "port": 2000,
  "messageLibrary": "messages/StandardInterface_0300_English_Messages.doc",
  "enableTLS": false,
  "transmissionCode": "ASCII",
  "responseDelayMs": 0,
  "uiPort": 8080,
  "pushOnConnect": [],
  "fitDownload": {
    "luno": "218",
    "msn": "000",
    "responseFlag": "0",
    "beforeGoInService": false,
    "delayMs": 500,
    "entries": [
      "023000255255255255255002000132000015000031138255007001035069103137001035069000000000000000000000000064064064000000000"
    ]
  },
  "tls": {
    "key": "path/to/key.pem",
    "cert": "path/to/cert.pem"
  },
  "rules": [
    {
      "name": "host-confirmation",
      "match": {
        "messageClass": "1",
        "subClass": "1"
      },
      "handler": "hostConfirmation"
    },
    {
      "name": "ddc-pin-validation",
      "match": {
        "messageClass": "1",
        "subClass": "1",
        "field": {
          "index": 7,
          "startsWith": "HHH"
        }
      },
      "handler": "ddcPinValidation"
    },
    {
      "name": "ddc-fastcash-stage1",
      "match": {
        "messageClass": "1",
        "subClass": "1",
        "field": {
          "index": 7,
          "startsWith": "AA A"
        }
      },
      "handler": "ddcFastCashStage1"
    },
    {
      "name": "ddc-withdrawal-stage1",
      "match": {
        "messageClass": "1",
        "subClass": "1",
        "field": {
          "index": 7,
          "startsWith": "AA B"
        }
      },
      "handler": "ddcWithdrawalStage1"
    },
    {
      "name": "ddc-withdrawal-stage2",
      "match": {
        "messageClass": "1",
        "subClass": "1",
        "field": {
          "index": 7,
          "startsWith": "AA C"
        }
      },
      "handler": "ddcWithdrawalStage2"
    },
    {
      "name": "ddc-balance-stage1",
      "match": {
        "messageClass": "1",
        "subClass": "1",
        "field": {
          "index": 7,
          "startsWith": "BA A"
        }
      },
      "handler": "ddcBalanceStage1"
    },
    {
      "name": "ddc-balance-stage2",
      "match": {
        "messageClass": "1",
        "subClass": "1",
        "field": {
          "index": 7,
          "startsWith": "BA B"
        }
      },
      "handler": "ddcBalanceStage2"
    },
    {
      "name": "ddc-transfer-own-stage1",
      "match": {
        "messageClass": "1",
        "subClass": "1",
        "field": {
          "index": 7,
          "startsWith": "GD B"
        }
      },
      "handler": "ddcTransferOwnStage1"
    },
    {
      "name": "ddc-transfer-own-stage2",
      "match": {
        "messageClass": "1",
        "subClass": "1",
        "field": {
          "index": 7,
          "startsWith": "GD C"
        }
      },
      "handler": "ddcTransferOwnStage2"
    },
    {
      "name": "opcode-library",
      "match": {
        "messageClass": "1",
        "subClass": "1"
      },
      "libraryKeyFromField": {
        "index": 7
      }
    },
    {
      "name": "withdrawal-request",
      "match": {
        "messageClass": "1",
        "subClass": "1",
        "field": {
          "index": 7,
          "startsWith": "A"
        }
      },
      "libraryKey": "A A  A A"
    },
    {
      "name": "balance-inquiry",
      "match": {
        "messageClass": "1",
        "subClass": "1",
        "field": {
          "index": 7,
          "startsWith": "C"
        }
      },
      "libraryKey": "C A  A A"
    },
    {
      "name": "everlink-ministatement",
      "match": {
        "messageClass": "1",
        "subClass": "1",
        "field": {
          "index": 7,
          "startsWith": "DG"
        }
      },
      "libraryKey": "HAA  A A"
    },
    {
      "name": "h-family-ministatement",
      "match": {
        "messageClass": "1",
        "subClass": "1",
        "field": {
          "index": 7,
          "startsWith": "H"
        }
      },
      "libraryKey": "HAA  A A"
    },
    {
      "name": "d-family-reply",
      "match": {
        "messageClass": "1",
        "subClass": "1",
        "field": {
          "index": 7,
          "startsWith": "D"
        }
      },
      "handler": "familyD"
    },
    {
      "name": "i-family-reply",
      "match": {
        "messageClass": "1",
        "subClass": "1",
        "field": {
          "index": 7,
          "startsWith": "I"
        }
      },
      "handler": "familyI"
    },
    {
      "name": "generic-fallback",
      "match": {
        "messageClass": "1",
        "subClass": "1"
      },
      "handler": "generic"
    },
    {
      "name": "powerup-go-in-service",
      "match": {
        "messageClass": "1",
        "subClass": "2",
        "field": {
          "index": 3,
          "startsWith": "B"
        }
      },
      "handler": "goInService"
    },
    {
      "name": "ready9-no-reply",
      "match": {
        "messageClass": "2",
        "field": {
          "index": 3,
          "startsWith": "9"
        }
      },
      "noReply": true
    },
    {
      "name": "ready-b-idle-no-reply",
      "match": {
        "messageClass": "2",
        "field": {
          "index": 3,
          "startsWith": "B"
        }
      },
      "noReply": true
    },
    {
      "name": "terminal-state-no-reply",
      "match": {
        "messageClass": "2",
        "field": {
          "index": 3,
          "startsWith": "F"
        }
      },
      "noReply": true
    },
    {
      "name": "unsolicited-status-no-reply",
      "match": {
        "messageClass": "1",
        "subClass": "2"
      },
      "noReply": true
    }
  ],
  "hostConfirmation": {
