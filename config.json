{
  "port": 2000,
  "messageLibrary": "messages/StandardInterface_0300_English_Messages.doc",
  "enableTLS": false,
  "transmissionCode": "ASCII",
  "responseDelayMs": 0,
  "eki": { "masterKey": "", "kbpk": "" },
  "uiPort": 8080,
  "pushOnConnect": [],
  "fitDownload": {
    "luno": "218",
    "msn": "000",
    "responseFlag": "0",
    "beforeGoInService": false,
    "delayMs": 500,
    "entries": [
      "023000255255255255255002000132000015000031138255007001035069103137001035069000000000000000000000000064064064000000000"
    ]
  },
  "tls": {
    "key": "path/to/key.pem",
    "cert": "path/to/cert.pem"
  },
  "rules": [
    {
      "name": "host-confirmation",
      "match": {
        "messageClass": "1",
        "subClass": "1"
      },
      "handler": "hostConfirmation"
    },
    {
      "name": "settlement-request",
      "match": {
        "messageClass": "1",
        "subClass": "1",
        "field": {
          "index": 7,
          "pattern": "^(J[A-INS]  [ A-G]   |C A     )$"
        }
      },
      "handler": "settlement"
    },
    {
      "name": "reply-fee",
      "_comment": "交易应答里带手续费（ATM 的 ndcFeeAcceptanceInOpcode）：opcode 位 7 空格回手续费应答，A/C 放行，B/D 回取消应答。缺省关（replyFee.enabled）；必须在 opcode-library 之前，否则位 7=B 的取款落到批准出钞。",
      "match": {
        "messageClass": "1",
        "subClass": "1"
      },
      "handler": "replyFee"
    },
    {
      "name": "oar-selection",
      "_comment": "主机 OAR 账户选择：首条请求回 ITR（FROM;AccountANumber=…），Buffer B 为账户字母放行，E 回取消应答。缺省关（oarSelection.enabled）。",
      "match": {
        "messageClass": "1",
        "subClass": "1"
      },
      "handler": "oarSelection"
    },
    {
      "name": "opcode-library",
      "match": {
        "messageClass": "1",
        "subClass": "1"
      },
      "libraryKeyFromField": {
        "index": 7
      }
    },
    {
      "name": "withdrawal-request",
      "match": {
        "messageClass": "1",
        "subClass": "1",
        "field": {
          "index": 7,
          "startsWith": "A"
        }
      },
      "libraryKey": "A A  A A"
    },
    {
      "name": "balance-inquiry",
      "match": {
        "messageClass": "1",
        "subClass": "1",
        "field": {
          "index": 7,
          "startsWith": "C"
        }
      },
      "libraryKey": "C A  A A"
    },
    {
      "name": "everlink-ministatement",
      "match": {
        "messageClass": "1",
        "subClass": "1",
        "field": {
          "index": 7,
          "startsWith": "DG"
        }
      },
      "libraryKey": "HAA  A A"
    },
    {
      "name": "h-family-ministatement",
      "match": {
        "messageClass": "1",
        "subClass": "1",
        "field": {
          "index": 7,
          "startsWith": "H"
        }
      },
      "libraryKey": "HAA  A A"
    },
    {
      "name": "d-family-reply",
      "match": {
        "messageClass": "1",
        "subClass": "1",
        "field": {
          "index": 7,
          "startsWith": "D"
        }
      },
      "handler": "familyD"
    },
    {
      "name": "i-family-reply",
      "match": {
        "messageClass": "1",
        "subClass": "1",
        "field": {
          "index": 7,
          "startsWith": "I"
        }
      },
      "handler": "familyI"
    },
    {
      "name": "generic-fallback",
      "match": {
        "messageClass": "1",
        "subClass": "1"
      },
      "handler": "generic"
    },
    {
      "name": "powerup-go-in-service",
      "match": {
        "messageClass": "1",
        "subClass": "2",
        "field": {
          "index": 3,
          "startsWith": "B"
        }
      },
      "handler": "goInService"
    },
    {
      "name": "digc-reply",
      "_comment": "8b：卡片层失败（DIG c）后 ATM 等主机新应答；digCReply.enabled 时回 class 4（MCN 0、FID 5、NS=digCReply.nextState、凭条、不带 CAM）。缺省关；必须在 status 规则（ddc-device-fault-reply / ready*-no-reply）之前。",
      "match": {
        "messageClass": "2",
        "field": {
          "index": 3,
          "equals": "8"
        }
      },
      "handler": "digCReply"
    },
    {
      "name": "ready9-no-reply",
      "match": {
        "messageClass": "2",
        "field": {
          "index": 3,
          "startsWith": "9"
        }
      },
      "noReply": true
    },
    {
      "name": "ready-b-idle-no-reply",
      "match": {
        "messageClass": "2",
        "field": {
          "index": 3,
          "startsWith": "B"
        }
      },
      "noReply": true
    },
    {
      "name": "terminal-state-no-reply",
      "match": {
        "messageClass": "2",
        "field": {
          "index": 3,
          "startsWith": "F"
        }
      },
      "noReply": true
    },
    {
      "name": "settlement-p20-go-in-service",
      "match": {
        "messageClass": "1",
        "subClass": "2",
        "field": {
          "index": 3,
          "startsWith": "P20"
        }
      },
      "handler": "settlementGis"
    },
    {
      "name": "unsolicited-status-no-reply",
      "match": {
        "messageClass": "1",
        "subClass": "2"
      },
      "noReply": true
    }
  ],
  "hostConfirmation": {
    "enabled": false,
    "scenario": "surcharge",
    "declineNextState": "048"
  },
  "withdrawal": {
    "cassettes": [
      50,
      100,
      500,
      1000
    ],
    "approvedNextState": "123",
    "declineNextState": "048",
    "maxAmount": null,
    "returnCard": "0",
    "amountFieldIndex": 8,
