    }
  },
  "familyD": {
    "nextState": "698",
    "returnCard": "0",
    "printerFlag": "1",
    "includeCam": false,
    "camArc": "00",
    "receipt": {
      "screen": "",
      "printerData": "<GS>1  PIN CHANGE<LF>  <DATE> <TIME><LF><FF>"
    }
  },
  "familyI": {
    "nextState": "175",
    "returnCard": "0",
    "printerFlag": "1",
    "includeCam": false,
    "camArc": "00",
    "receipt": {
      "screen": "",
      "printerData": "<GS>1  TRANSACTION<LF>  <DATE> <TIME><LF><FF>"
    }
  },
  "settlement": {
    "nextState": "001",
    "functionId": "5",
    "cassetteCounts": [
      2000,
      2000,
      2000,
      2000,
      0,
      0,
      0
    ],
    "autoGisOnP20": true
  },
  "cam": {
    "enabled": false,
    "arc": "00",
    "iad": "11223344556677883030",
    "scripts": [],
    "omit": false,
    "badIad": false,
    "digCReply": {
      "enabled": false,
      "nextState": "048",
      "receipt": "CARD DECLINED"
    }
  },
  "replyFee": {
    "enabled": false,
    "nextState": "008",
    "fee": "$2.00",
    "cancelReplyNextState": "048",
    "noReplyToCancel": false
  },
  "oarSelection": {
    "enabled": false,
    "accounts": [
      {
        "number": "1234567890",
        "name": "SAVINGS"
      },
      {
        "number": "2234567890",
        "name": "CHEQUE"
      }
    ],
    "direction": "auto",
    "includePinChange": false
  }
}
